# Public API origin used by the Expo app (inlined at bundle time).
# Default in code if this is unset: https://upi-shield-7mcc.onrender.com
#
# Local emulator / Expo web on the same machine:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
#
# Physical phone: localhost is the phone, not your PC. Use the PC LAN IP:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5000
#
# Production:
EXPO_PUBLIC_API_BASE_URL=https://upi-shield-7mcc.onrender.com
