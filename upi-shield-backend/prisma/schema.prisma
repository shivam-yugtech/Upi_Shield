generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ThreatPhrase {
  id        String       @id @default(cuid())
  phrase    String       @unique
  source    String
  status    PhraseStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
}

model ScamReport {
  id        String       @id @default(cuid())
  phrase    String       @unique
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
}

model Scan {
  id          String         @id @default(cuid())
  messageHash String
  messageText String
  isScam      Boolean
  riskScore   Int
  category    String
  signals     Json
  reason      String
  urlDetected Boolean
  createdAt   DateTime       @default(now())
  feedback    ScanFeedback?

  @@index([createdAt])
  @@index([messageHash])
}

model ScanFeedback {
  id        String           @id @default(cuid())
  scanId    String           @unique
  feedback  FeedbackType
  createdAt DateTime         @default(now())
  scan      Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

enum PhraseStatus {
  ACTIVE
  PENDING
  DISABLED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedbackType {
  FALSE_POSITIVE
  CONFIRMED_SCAM
  UNSURE
}
